### Define command to view all the defined rifle opener method options
cmd open-with ${{
    set -f
    method=$(rifle -l $fx | sed -e "s/:[a-zA-Z]*:[a-zA-Z]*:/ \| /" | fzf \
      --no-sort --disabled --layout=reverse \
      --no-info --prompt="Open with > " \
      --bind=change:clear-query \
      --bind=q:abort \
      --bind=j:down,k:up \
      --bind=d:half-page-down,u:half-page-up \
      --bind=space:page-down,backspace:page-up \
      --bind=g:first,G:last \
      --bind=f:jump,jump:accept \
      --tmux=center,80%,80% | sed -e 's/ |.*//g')
    [ -n "${method}" ] && rifle -p $method $fx
}}

map o open-with
map O open-with
nmap <s-enter> open-with

# Restore LF's native Visual-mode endpoint switch; map applies to both Normal
# and Visual modes, so the explicit vmap must come after the open-with maps.
vmap o visual-change

# Lowercase c is the shared clear/cancel submenu. Ctrl-V remains the direct
# cancel key, including while LF is in Visual or Command-line mode.
cmd clear_unselect &{{
  rm ~/.local/share/lf/files 2>/dev/null
  lf -remote "send $id clear"
  lf -remote "send $id unselect"
}}

map c
map cc clear_unselect
map cs :unselect; visual-discard
map cz push <c-v>

# Match Yazi's uppercase-C clipboard submenu. Combine LF's selected files and
# active Visual range, then fall back to the file under the cursor.
cmd clipboard-copy &{{
  kind=$1
  paths=$(printf '%s\n%s' "${fs:-}" "${fv:-}" | awk 'NF && !seen[$0]++')
  if [ -z "$paths" ]; then paths=$f; fi

  first=1
  {
    for item in $paths; do
      case "$kind" in
        path) value=$item ;;
        dirname) value=$(dirname -- "$item") ;;
        filename) value=$(basename -- "$item") ;;
        stem)
          value=$(basename -- "$item")
          case "$value" in
            .*|*.) ;;
            *.*) value=${value%.*} ;;
          esac
          ;;
      esac
      if [ "$first" -eq 0 ]; then printf '\n'; fi
      printf '%s' "$value"
      first=0
    done
  } | wl-copy
}}

map Cc clipboard-copy path
map Cd clipboard-copy dirname
map Cf clipboard-copy filename
map Cn clipboard-copy stem

